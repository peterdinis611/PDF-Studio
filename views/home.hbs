<div class="site-page" x-data="themeToggle" data-home-scroll>
  <div class="site-bg" aria-hidden="true">
    <div class="site-bg-mesh" data-parallax-vibe></div>
    <div class="site-bg-grain"></div>
    <span class="site-bg-orb site-bg-orb--a" data-parallax-orb="a"></span>
    <span class="site-bg-orb site-bg-orb--b" data-parallax-orb="b"></span>
    <span class="site-bg-orb site-bg-orb--c" data-parallax-orb="c"></span>
  </div>

  <header class="site-nav" data-site-nav>
    <div class="site-nav-inner">
      <a href="/" class="site-brand-link" aria-current="page">
        <span class="site-mark" aria-hidden="true"></span>
        <span class="site-brand-name">PDF Studio</span>
      </a>
      <nav class="site-nav-actions">
        <a href="#how" class="site-nav-link hidden sm:inline">How</a>
        <a href="#templates" class="site-nav-link hidden md:inline">Templates</a>
        <button
          type="button"
          class="site-icon-btn"
          @click="toggleTheme()"
          :title="theme === 'dark' ? 'Light mode' : 'Dark mode'"
        >
          <svg x-show="theme === 'dark'" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.4 6.4l-1.4-1.4M7 7L5.6 5.6m12.8 0L17 7M7 17l-1.4 1.4M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
          <svg x-show="theme === 'light'" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
          </svg>
        </button>
        <a href="/editor" class="site-nav-cta">Open editor</a>
      </nav>
    </div>
  </header>

  <section class="site-stage" id="build" data-home-pin>
    <div class="site-stage-sticky">
      <h1 class="site-display" aria-label="PDF Studio">
        <span class="site-display-lockup">
          <span class="site-display-pdf">PDF</span>
          <span class="site-display-studio">Studio</span>
        </span>
      </h1>

      <div class="site-stage-board">
        <div class="site-board" data-home-board>
          <div class="site-board-glow" aria-hidden="true"></div>
          <div class="site-board-crop" aria-hidden="true">
            <span class="site-crop site-crop--tl"></span>
            <span class="site-crop site-crop--tr"></span>
            <span class="site-crop site-crop--bl"></span>
            <span class="site-crop site-crop--br"></span>
          </div>
          <article class="site-sheet" data-home-preview>
            <header class="site-sheet-head">
              <span class="site-sheet-logo" data-sheet-el="logo">PS</span>
              <span class="site-sheet-meta" data-sheet-el="meta">Invoice 0042</span>
            </header>
            <div class="site-sheet-rule" data-sheet-el="rule"></div>
            <p class="site-sheet-to" data-sheet-el="to">Acme Design Co.</p>
            <p class="site-sheet-muted" data-sheet-el="muted">Net 14, due on receipt</p>
            <ul class="site-sheet-lines">
              <li data-sheet-el="line"><span>Brand guidelines</span><span>1 200</span></li>
              <li data-sheet-el="line"><span>Print-ready PDF set</span><span>480</span></li>
              <li data-sheet-el="line"><span>Revision pass</span><span>160</span></li>
            </ul>
            <div class="site-sheet-total" data-sheet-el="total">
              <span>Total due</span>
              <strong>1 840</strong>
            </div>
          </article>
        </div>
      </div>

      <div class="site-stage-caption">
        <div class="site-stage-panels">
          <div class="site-stage-panel is-active" data-stage-panel="0">
            <p class="site-lede">
              Design in the browser. Export a real PDF. No account — scroll and watch this sheet fill.
            </p>
            <div class="site-hero-cta">
              <a href="/editor?new=1" class="site-cta-primary">Start blank</a>
              <a href="/editor?template=invoice" class="site-cta-ghost">Open invoice</a>
            </div>
          </div>
          <div class="site-stage-panel" data-stage-panel="1">
            <h2 class="site-stage-title">Blank A4 lands</h2>
            <p class="site-lede">Empty sheet. Text, shapes, images, signatures place here.</p>
          </div>
          <div class="site-stage-panel" data-stage-panel="2">
            <h2 class="site-stage-title">Header locks brand</h2>
            <p class="site-lede">Mark and invoice id sit first.</p>
          </div>
          <div class="site-stage-panel" data-stage-panel="3">
            <h2 class="site-stage-title">Client lines ink in</h2>
            <p class="site-lede">Recipient, terms, due date type onto the page.</p>
          </div>
          <div class="site-stage-panel" data-stage-panel="4">
            <h2 class="site-stage-title">Line items stack</h2>
            <p class="site-lede">Rows and amounts settle with honest spacing.</p>
          </div>
          <div class="site-stage-panel" data-stage-panel="5">
            <h2 class="site-stage-title">Total. Then export.</h2>
            <p class="site-lede">Sum ticks live. Export when it feels finished.</p>
            <div class="site-hero-cta">
              <a href="/editor?new=1" class="site-cta-primary">Open editor</a>
            </div>
          </div>
        </div>

        <div class="site-stage-progress" aria-hidden="true">
          <div class="site-stage-progress-track">
            <div class="site-stage-progress-bar" data-pin-progress></div>
          </div>
          <div class="site-stage-steps" data-pin-steps>
            <span class="site-stage-step is-active" data-step="0"></span>
            <span class="site-stage-step" data-step="1"></span>
            <span class="site-stage-step" data-step="2"></span>
            <span class="site-stage-step" data-step="3"></span>
            <span class="site-stage-step" data-step="4"></span>
            <span class="site-stage-step" data-step="5"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-chapter" id="how" data-chapter>
    <div class="site-chapter-inner">
      <header class="site-chapter-head" data-reveal>
        <h2 class="site-chapter-title">Three moves. Then you’re done.</h2>
        <p class="site-lede">Open a tab, shape the page, ship the file.</p>
      </header>
      <ol class="site-how-rail">
        <li class="site-how-step" data-reveal style="--reveal-delay: 0ms">
          <span class="site-how-icon" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
          </span>
          <h3>Pick a start</h3>
          <p>Blank canvas or a template — invoice, CV, proposal, whatever you’re sending today.</p>
        </li>
        <li class="site-how-connector" aria-hidden="true"></li>
        <li class="site-how-step" data-reveal style="--reveal-delay: 70ms">
          <span class="site-how-icon" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M4 20l4.5-1L19 8.5a2.5 2.5 0 00-3.5-3.5L5 15.5 4 20z"/></svg>
          </span>
          <h3>Place and tweak</h3>
          <p>Drag text, shapes, images, signatures. Guides keep the layout honest.</p>
        </li>
        <li class="site-how-connector" aria-hidden="true"></li>
        <li class="site-how-step" data-reveal style="--reveal-delay: 140ms">
          <span class="site-how-icon" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
          </span>
          <h3>Export the PDF</h3>
          <p>Fonts embedded, pages sized — a file you can actually send.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="site-chapter site-chapter--templates" id="templates" data-chapter>
    <div class="site-chapter-inner">
      <header class="site-chapter-head" data-reveal>
        <h2 class="site-chapter-title">Proofs on the rack</h2>
        <p class="site-lede">Every layout opens editable. Pick one and finish it.</p>
      </header>
      <div class="site-tpl-wrap" data-reveal>
        <div class="site-tpl-fade site-tpl-fade--left" aria-hidden="true"></div>
        <div class="site-tpl-fade site-tpl-fade--right" aria-hidden="true"></div>
        <button type="button" class="site-tpl-arrow site-tpl-arrow--prev" data-rack-prev aria-label="Scroll templates left">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" class="site-tpl-arrow site-tpl-arrow--next" data-rack-next aria-label="Scroll templates right">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
        <ul class="site-tpl-rack" data-tpl-rack>
          <li><a href="/editor?new=1" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--blank"></span><span class="site-tpl-name">Blank A4</span></a></li>
          <li><a href="/editor?template=invoice" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--invoice"></span><span class="site-tpl-name">Invoice</span></a></li>
          <li><a href="/editor?template=letter" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--letter"></span><span class="site-tpl-name">Letter</span></a></li>
          <li><a href="/editor?template=cv" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--cv"></span><span class="site-tpl-name">CV</span></a></li>
          <li><a href="/editor?template=report" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--report"></span><span class="site-tpl-name">Report</span></a></li>
          <li><a href="/editor?template=proposal" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--proposal"></span><span class="site-tpl-name">Proposal</span></a></li>
          <li><a href="/editor?template=flyer" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--flyer"></span><span class="site-tpl-name">Flyer</span></a></li>
          <li><a href="/editor?template=certificate" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--cert"></span><span class="site-tpl-name">Certificate</span></a></li>
          <li><a href="/editor?template=menu" class="site-tpl-proof"><span class="site-tpl-thumb site-template-thumb--menu"></span><span class="site-tpl-name">Menu</span></a></li>
        </ul>
        <p class="site-tpl-hint" aria-hidden="true">Drag or scroll for more</p>
      </div>
    </div>
  </section>

  <section class="site-finale" id="cta" data-chapter>
    <div class="site-finale-band" data-reveal>
      <div class="site-finale-copy">
        <h2 class="site-finale-title">Finish a page today.</h2>
        <p class="site-lede">Local session. No signup. Make the PDF.</p>
      </div>
      <div class="site-hero-cta">
        <a href="/editor?new=1" class="site-cta-primary">Start blank</a>
        <a href="/editor?template=proposal" class="site-cta-ghost">Open proposal</a>
      </div>
    </div>
  </section>

