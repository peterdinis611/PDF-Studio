{{!-- Shared modals --}}
<div
  x-show="showPdfImportModal"
  x-cloak
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pdf-import-modal-title"
  @keydown.escape.window="closePdfImportModal()"
>
  <div class="modal-panel max-w-lg" @click.outside="closePdfImportModal()">
    <h3 id="pdf-import-modal-title" class="modal-title">Import PDF</h3>
    <p class="mt-1 text-xs text-slate-muted">Stays in this browser tab — nothing is uploaded to the server.</p>

    <div class="mt-5 space-y-2">
      <p class="panel-label">Import mode</p>
      <div class="grid gap-2 sm:grid-cols-2">
        <button
          type="button"
          class="rounded-xl border px-3 py-3 text-left transition"
          :class="pdfImportChoice === 'overlay' ? 'border-accent bg-accent/10' : 'border-slate-line hover:border-accent/60'"
          @click="pdfImportChoice = 'overlay'"
        >
          <span class="block text-sm font-medium text-fg">Overlay</span>
          <span class="mt-1 block text-[11px] leading-snug text-slate-muted">Keep the PDF as a background and place notes, stamps, or shapes on top.</span>
        </button>
        <button
          type="button"
          class="rounded-xl border px-3 py-3 text-left transition"
          :class="pdfImportChoice === 'editable' ? 'border-accent bg-accent/10' : 'border-slate-line hover:border-accent/60'"
          @click="pdfImportChoice = 'editable'"
        >
          <span class="block text-sm font-medium text-fg">Editable text</span>
          <span class="mt-1 block text-[11px] leading-snug text-slate-muted">Extract text and images into editable blocks. Best for PDFs with a real text layer.</span>
        </button>
      </div>
      <label class="settings-row mt-3" x-show="pdfImportChoice === 'editable'">
        <span>OCR scanned pages (experimental, first 3 pages)</span>
        <input type="checkbox" class="accent-accent" x-model="pdfImportOcr" :disabled="pdfImportBusy" />
      </label>
    </div>

    <div class="mt-5">
      <p class="panel-label">File</p>
      <div
        class="mt-1.5 flex min-h-30 cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-slate-line bg-black/3 px-4 py-6 text-center transition hover:border-accent dark:bg-white/3"
        :class="pdfImportDragOver && 'border-accent bg-accent/10'"
        @click="$refs.pdfImportDialogInput.click()"
        @dragover.prevent="pdfImportDragOver = true"
        @dragleave.prevent="pdfImportDragOver = false"
        @drop.prevent="onPdfImportDrop($event)"
      >
        <p class="text-sm font-medium text-fg" x-text="pdfImportFileName || 'Drop a PDF here'"></p>
        <p class="mt-1 text-xs text-slate-muted" x-text="pdfImportFileName ? 'Click to choose a different file' : 'or click to browse'"></p>
      </div>
      <input
        type="file"
        accept="application/pdf,.pdf"
        class="hidden"
        x-ref="pdfImportDialogInput"
        @change="onPdfImportDialogFile($event)"
      />
    </div>

    <p class="mt-3 text-xs text-slate-muted" x-show="pdfImportBusy && pdfImportStatus" x-text="pdfImportStatus"></p>

    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="closePdfImportModal()" x-text="pdfImportBusy ? 'Close' : 'Cancel'"></button>
      <button
        type="button"
        class="btn-primary"
        :disabled="pdfImportBusy || !pdfImportFile"
        @click="confirmPdfImport()"
      >
        <span x-text="pdfImportBusy ? 'Importing…' : 'Import'"></span>
      </button>
    </div>
  </div>
</div>

  <div
    x-show="showExportModal"
    x-cloak
    class="modal-backdrop"
    role="dialog"
    aria-modal="true"
    aria-labelledby="export-modal-title"
    @keydown.escape.window="showExportModal = false"
  >
    <div class="modal-panel modal-panel--export" @click.outside="showExportModal = false">
      <header class="modal-head">
        <h3 id="export-modal-title" class="modal-title">Export PDF</h3>
        <p class="modal-lead">Press-ready options for this document.</p>
      </header>
      <div class="modal-body space-y-5 text-sm">
        <section class="modal-section">
          <p class="modal-section-label">Preset</p>
          <div class="seg-control" role="group" aria-label="Export preset">
            <button type="button" class="seg-btn" :class="exportSettings.intent === 'screen' && 'is-active'" @click="setExportPreset('screen')">Screen</button>
            <button type="button" class="seg-btn" :class="exportSettings.intent === 'print' && 'is-active'" @click="setExportPreset('print')">Print</button>
          </div>
          <p class="modal-hint">Screen = lighter · Print = higher quality + PDF/A-friendly</p>
        </section>

        <section class="modal-section grid grid-cols-2 gap-3">
          <div>
            <label class="panel-label">Margin (pt)</label>
            <input type="number" min="0" max="72" class="panel-input" x-model.number="exportSettings.margin" @change="saveExportSettings()" />
          </div>
          <div>
            <label class="panel-label">Quality <span class="font-mono text-[10px] text-slate-muted" x-text="Math.round(exportSettings.imageQuality * 100) + '%'"></span></label>
            <input type="range" min="0.4" max="1" step="0.05" class="mt-2 w-full accent-accent" x-model.number="exportSettings.imageQuality" @change="saveExportSettings()" />
          </div>
        </section>

        <section class="modal-section">
          <label class="panel-label">PDF/A</label>
          <div class="seg-control seg-control--3" role="group" aria-label="PDF/A mode">
            <button type="button" class="seg-btn" :class="exportSettings.pdfaMode === 'off' && 'is-active'" @click="exportSettings.pdfaMode = 'off'; exportSettings.pdfaLite = false; saveExportSettings()">Off</button>
            <button type="button" class="seg-btn" :class="exportSettings.pdfaMode === 'friendly' && 'is-active'" @click="exportSettings.pdfaMode = 'friendly'; exportSettings.pdfaLite = true; saveExportSettings()">Friendly</button>
            <button type="button" class="seg-btn" :class="exportSettings.pdfaMode === 'strict' && 'is-active'" @click="exportSettings.pdfaMode = 'strict'; exportSettings.pdfaLite = true; saveExportSettings()">Strict</button>
          </div>
          <p class="modal-hint">Best-effort archival hints — not veraPDF certified</p>
        </section>

        <section class="modal-section">
          <p class="modal-section-label">Burn &amp; include</p>
          <div class="toggle-stack">
            <label class="settings-row">
              <span>Compress images</span>
              <input type="checkbox" class="accent-accent" x-model="exportSettings.compressImages" @change="saveExportSettings()" />
            </label>
            <label class="settings-row">
              <span>Flatten form fields</span>
              <input type="checkbox" class="accent-accent" x-model="exportSettings.flattenForms" @change="exportSettings.flatten = exportSettings.flattenForms; saveExportSettings()" />
            </label>
            <label class="settings-row">
              <span>Flatten annotations</span>
              <input type="checkbox" class="accent-accent" x-model="exportSettings.flattenAnnotations" @change="saveExportSettings()" />
            </label>
            <label class="settings-row">
              <span>Review comments</span>
              <input type="checkbox" class="accent-accent" x-model="exportSettings.includeComments" @change="saveExportSettings()" />
            </label>
            <label class="settings-row">
              <span>Watermark</span>
              <input type="checkbox" class="accent-accent" x-model="exportSettings.includeWatermark" @change="saveExportSettings()" />
            </label>
          </div>
        </section>

        <section class="modal-section">
          <label class="panel-label">Password <span class="font-normal normal-case tracking-normal text-slate-muted">(optional)</span></label>
          <input
            type="password"
            class="panel-input"
            autocomplete="new-password"
            placeholder="Leave blank for no encryption"
            x-model="exportPassword"
            :disabled="exportSettings.pdfaMode === 'strict'"
          />
          <p class="modal-hint" x-text="exportSettings.pdfaMode === 'strict' ? 'Disabled in PDF/A strict mode' : 'Not saved · open-password only'"></p>
        </section>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-ghost" @click="showExportModal = false">Cancel</button>
        <button type="button" class="btn-primary" :disabled="exporting" @click="saveExportSettings(); exportPdf()">
          <span x-text="exporting ? 'Exporting…' : 'Download PDF'"></span>
        </button>
      </div>
    </div>
  </div>

<div x-show="showFindReplace" x-cloak class="modal-backdrop items-start pt-24" role="dialog" aria-modal="true" aria-labelledby="find-modal-title" @keydown.escape.window="showFindReplace = false; findHighlightId = null">
  <div class="modal-panel max-w-lg" @click.outside="showFindReplace = false; findHighlightId = null">
    <h3 id="find-modal-title" class="modal-title">Find &amp; replace</h3>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div>
        <label class="panel-label">Find</label>
        <input type="text" class="panel-input" x-model="findQuery" @keydown.enter="runFind()" />
      </div>
      <div>
        <label class="panel-label">Replace</label>
        <input type="text" class="panel-input" x-model="replaceQuery" />
      </div>
    </div>
    <p class="mt-3 text-xs text-slate-muted">
      <span x-text="findMatches.length"></span> matches
      <span x-show="findIndex >= 0" x-text="' · #' + (findIndex + 1)"></span>
    </p>
    <div class="modal-actions flex-wrap">
      <button type="button" class="btn-ghost" @click="runFind()">Find</button>
      <button type="button" class="btn-ghost" @click="findNext()">Next</button>
      <button type="button" class="btn-ghost" @click="replaceCurrent()">Replace</button>
      <button type="button" class="btn-ghost" @click="replaceAll()">Replace all</button>
      <button type="button" class="btn-ghost ml-auto" @click="showFindReplace = false; findHighlightId = null">Close</button>
    </div>
  </div>
</div>

<div x-show="showBrandKit" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="brand-modal-title" @keydown.escape.window="showBrandKit = false">
  <div class="modal-panel" @click.outside="showBrandKit = false">
    <h3 id="brand-modal-title" class="modal-title">Brand kit</h3>
    <p class="mt-1 text-xs text-slate-muted">Saved in this browser only.</p>
    <div class="mt-4 space-y-3 text-sm">
      <div>
        <label class="panel-label">Brand name</label>
        <input type="text" class="panel-input" x-model="brand.name" @change="saveBrand()" />
      </div>
      <div>
        <label class="panel-label">Default font</label>
        <select class="panel-select" x-model="brand.defaultFont" @change="saveBrand()">
          <template x-for="f in fontOptions" :key="f.id">
            <option :value="f.id" x-text="f.label"></option>
          </template>
        </select>
      </div>
      <div>
        <label class="panel-label">Colors</label>
        <div class="flex flex-wrap gap-2">
          <template x-for="(c, i) in brand.colors" :key="i">
            <input type="color" class="h-9 w-12 cursor-pointer rounded-lg border border-slate-line bg-transparent" x-model="brand.colors[i]" @change="saveBrand()" />
          </template>
        </div>
      </div>
      <div>
        <label class="panel-label">Logo</label>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-ghost" @click="$refs.brandLogoInput.click()">Upload logo</button>
          <button type="button" class="btn-ghost" :disabled="!brand.logoUrl" @click="insertBrandLogo()">Insert logo</button>
        </div>
        <p class="mt-1 truncate text-xs text-slate-muted" x-text="brand.logoName || 'No logo yet'"></p>
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="applyBrandToSelection()">Apply to selection</button>
      <button type="button" class="btn-primary" @click="saveBrand(); showBrandKit = false">Done</button>
    </div>
  </div>
</div>

<div x-show="showDocLibrary" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="doc-library-modal-title" @keydown.escape.window="showDocLibrary = false">
  <div class="modal-panel max-w-lg" @click.outside="showDocLibrary = false">
    <h3 id="doc-library-modal-title" class="modal-title">Local documents</h3>
    <p class="mt-1 text-xs text-slate-muted">Stored in your browser. Share via JSON download.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" class="btn-ghost" @click="newDocument()">New</button>
      <button type="button" class="btn-ghost" @click="$refs.jsonInput.click()">Open JSON</button>
      <button type="button" class="btn-ghost" @click="showDocLibrary = false; openPdfImportModal()">Open PDF</button>
      <button type="button" class="btn-ghost" @click="downloadStudioJson()">Share JSON</button>
      <button type="button" class="btn-ghost" @click="duplicateDocInLibrary()">Duplicate</button>
      <button type="button" class="btn-ghost" :disabled="!librarySelectedIds.length" @click="batchExportLibraryZip()">Export selected ZIP</button>
    </div>
    <ul class="mt-4 max-h-64 space-y-1.5 overflow-y-auto">
      <template x-for="d in docLibrary" :key="d.id">
        <li class="flex items-center gap-2">
          <input
            type="checkbox"
            class="accent-accent"
            :checked="librarySelectedIds.includes(d.id)"
            @change="toggleLibrarySelect(d.id)"
          />
          <button
            type="button"
            class="doc-row min-w-0 flex-1"
            :class="d.id === doc.id && 'is-active'"
            @click="openDocFromLibrary(d.id)"
          >
            <span class="truncate font-medium text-fg" x-text="d.name"></span>
            <span class="ml-2 shrink-0 font-mono text-[10px] text-slate-muted" x-text="new Date(d.updatedAt).toLocaleString()"></span>
          </button>
        </li>
      </template>
      <li x-show="docLibrary.length === 0" class="py-8 text-center text-sm text-slate-muted">No saved documents yet.</li>
    </ul>
    <div class="modal-actions">
      <button type="button" class="btn-ghost ml-auto" @click="showDocLibrary = false">Close</button>
    </div>
  </div>
</div>

{{!-- Mail merge modal --}}
<div
  x-show="showMailMerge"
  x-cloak
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mail-merge-title"
  @keydown.escape.window="showMailMerge = false"
>
  <div class="modal-panel max-w-lg" @click.outside="showMailMerge = false">
    <h3 id="mail-merge-title" class="modal-title">Mail merge</h3>
    <p class="mt-1 text-xs text-slate-muted">
      CSV, XLSX, or JSON. Tokens like field names, <code class="text-accent-soft">seq</code>, <code class="text-accent-soft">bates</code>. Table line-items: JSON array in column <code class="text-accent-soft">items</code>.
    </p>
    <div class="mt-4 space-y-3 text-sm">
      <label class="btn-ghost flex cursor-pointer items-center justify-center">
        <input type="file" class="sr-only" accept=".csv,.xlsx,.xls,.json,text/csv,application/json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" @change="onMailMergeFileSelected($event)" />
        <span x-text="mailMergeFileName ? ('Data: ' + mailMergeFileName) : 'Upload CSV / XLSX / JSON…'"></span>
      </label>
      <p class="text-xs text-slate-muted" x-show="mailMergeRows.length" x-text="mailMergeRows.length + ' row(s) · fields: ' + mailMergeHeaders.join(', ')"></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn-ghost text-xs" :class="mailMergeMode === 'single' && 'bg-accent/15 text-accent-soft'" @click="mailMergeMode = 'single'">One multi-page PDF</button>
        <button type="button" class="btn-ghost text-xs" :class="mailMergeMode === 'zip' && 'bg-accent/15 text-accent-soft'" @click="mailMergeMode = 'zip'">ZIP (1 PDF / row)</button>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="panel-label">Seq start</label>
          <input type="number" min="1" class="panel-input" x-model.number="mailMergeSeqStart" />
        </div>
        <div class="flex items-end">
          <button type="button" class="btn-ghost w-full text-xs" @click="insertMergeToken('seq')">Insert seq token</button>
        </div>
      </div>
      <div x-show="mailMergeHeaders.length" class="flex flex-wrap gap-1.5">
        <template x-for="h in mailMergeHeaders" :key="h">
          <button type="button" class="btn-ghost text-xs" @click="insertMergeToken(h)" x-text="'{{' + h + '}}'"></button>
        </template>
      </div>
      <div x-show="mailMergePreview" class="rounded-md border border-slate-line bg-slate-hover/40 p-3 text-xs">
        <p class="mb-1 font-medium text-fg">Preview (first row)</p>
        <template x-for="h in mailMergeHeaders" :key="'pv-' + h">
          <p class="text-slate-muted"><span class="text-fg" x-text="h"></span>: <span x-text="mailMergePreview?.[h] || ''"></span></p>
        </template>
      </div>
      <div x-show="fieldAuditIssues.length" class="rounded-md border border-amber-500/40 bg-amber-500/10 p-3 text-xs">
        <p class="mb-1 font-medium text-fg">Field audit</p>
        <template x-for="issue in fieldAuditIssues" :key="issue.token + issue.message">
          <p class="text-slate-muted" x-text="issue.message"></p>
        </template>
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="refreshFieldAudit()">Re-audit</button>
      <button type="button" class="btn-ghost" @click="showMailMerge = false">Cancel</button>
      <button type="button" class="btn-primary" :disabled="!mailMergeRows.length" @click="runMailMerge()">
        <span x-text="mailMergeMode === 'zip' ? 'Download ZIP' : 'Generate pages'"></span>
      </button>
    </div>
  </div>
</div>

{{!-- Preflight modal --}}
<div x-show="showPreflight" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showPreflight = false">
  <div class="modal-panel max-w-lg" @click.outside="showPreflight = false">
    <header class="modal-head">
      <h3 class="modal-title">Preflight</h3>
      <p class="modal-lead">Print &amp; accessibility checklist before export.</p>
    </header>
    <div class="mt-3 flex flex-wrap gap-1.5 text-[11px]" x-show="preflightSummary">
      <span class="pill pill--error" x-show="preflightSummary.error" x-text="preflightSummary.error + ' errors'"></span>
      <span class="pill pill--warn" x-show="preflightSummary.warn" x-text="preflightSummary.warn + ' warnings'"></span>
      <span class="pill" x-show="preflightSummary.info" x-text="preflightSummary.info + ' info'"></span>
    </div>
    <ul class="mt-4 max-h-72 space-y-1.5 overflow-y-auto text-sm">
      <template x-for="(issue, i) in preflightIssues" :key="i">
        <li>
          <button
            type="button"
            class="preflight-issue"
            :class="{
              'preflight-issue--error': issue.level === 'error',
              'preflight-issue--warn': issue.level === 'warn',
              'is-focusable': !!issue.elId,
            }"
            @click="focusPreflightIssue(issue)"
          >
            <span class="preflight-issue-meta" x-text="issue.level + ' · ' + issue.code"></span>
            <p class="preflight-issue-msg" x-text="issue.message"></p>
            <p class="preflight-issue-hint" x-show="issue.elId">Select on canvas →</p>
          </button>
        </li>
      </template>
      <li x-show="!preflightIssues.length" class="empty-state">
        <p class="empty-state-title">Clean press sheet</p>
        <p class="empty-state-body">No issues flagged for this document.</p>
      </li>
    </ul>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="showPreflight = false; openExportModal()">Export…</button>
      <button type="button" class="btn-ghost ml-auto" @click="showPreflight = false">Close</button>
    </div>
  </div>
</div>

{{!-- E-sign modal --}}
<div x-show="showESign" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showESign = false">
  <div class="modal-panel max-w-lg" @click.outside="showESign = false">
    <header class="modal-head">
      <h3 class="modal-title">E-sign</h3>
      <p class="modal-lead">Local signer order + audit trail. Not eIDAS / not a legal service.</p>
    </header>
    <div class="mt-4 space-y-3 text-sm" x-show="!eSignPkg">
      <label class="panel-label">Signers <span class="font-normal normal-case tracking-normal text-slate-muted">(comma-separated, in order)</span></label>
      <input type="text" class="panel-input" placeholder="Alice, Bob" x-model="eSignNames" />
      <button type="button" class="btn-primary" @click="startESign()">Create package</button>
    </div>
    <div class="mt-4 space-y-2 text-sm" x-show="eSignPkg">
      <template x-for="s in eSignPkg?.signers || []" :key="s.id">
        <div class="flex items-center justify-between gap-2 rounded-lg border border-slate-line px-3 py-2">
          <div class="min-w-0">
            <p class="truncate font-medium text-fg" x-text="s.order + '. ' + s.name"></p>
            <p class="font-mono text-[10px] uppercase tracking-wide text-slate-muted" x-text="s.status"></p>
          </div>
          <button type="button" class="btn-ghost text-xs" :disabled="s.status === 'signed'" @click="signAs(s.id)">Sign</button>
        </div>
      </template>
      <button type="button" class="btn-ghost text-xs" @click="downloadESignTrail()">Download audit trail</button>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-ghost ml-auto" @click="showESign = false">Close</button>
    </div>
  </div>
</div>

{{!-- Signature modal --}}
<div
  x-show="showSignatureModal"
  x-cloak
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="signature-modal-title"
  @keydown.escape.window="closeSignatureModal()"
>
  <div class="modal-panel max-w-xl" @click.outside="closeSignatureModal()">
    <header class="modal-head">
      <h3 id="signature-modal-title" class="modal-title">Sign document</h3>
      <p class="modal-lead">Draw, type, or upload — placed on the active page.</p>
    </header>

    <div class="seg-control seg-control--3 mt-4" role="tablist" aria-label="Signature method">
      <button type="button" class="seg-btn" role="tab" :class="signatureTab === 'draw' && 'is-active'" @click="signatureTab = 'draw'; resetSignaturePad()">Draw</button>
      <button type="button" class="seg-btn" role="tab" :class="signatureTab === 'type' && 'is-active'" @click="signatureTab = 'type'; clearSignaturePad()">Type</button>
      <button type="button" class="seg-btn" role="tab" :class="signatureTab === 'upload' && 'is-active'" @click="signatureTab = 'upload'">Upload</button>
    </div>

    <div class="mt-4" x-show="signatureTab !== 'upload'">
      <div class="mb-2 flex items-center justify-between gap-3">
        <label class="flex items-center gap-2 text-xs text-slate-muted">
          Ink
          <input type="color" class="h-7 w-9 cursor-pointer rounded-sm border border-slate-line bg-transparent" x-model="signatureInk" @change="signatureTab === 'type' && renderTypedSignature()" />
        </label>
        <button type="button" class="text-xs text-slate-muted underline hover:text-fg" @click="clearSignaturePad()">Clear</button>
      </div>
      <div x-show="signatureTab === 'type'" class="mb-2">
        <input
          type="text"
          class="panel-input"
          placeholder="Type your name"
          x-model="signatureTyped"
          @input="renderTypedSignature()"
        />
      </div>
      <canvas
        x-ref="signaturePad"
        class="h-44 w-full cursor-crosshair touch-none rounded-xl border border-dashed border-slate-line bg-white"
        style="touch-action: none"
        @pointerdown="onSignaturePointerDown($event)"
        @pointermove="onSignaturePointerMove($event)"
        @pointerup="onSignaturePointerUp($event)"
        @pointerleave="onSignaturePointerUp($event)"
      ></canvas>
      <p class="mt-1.5 text-[10px] text-slate-muted" x-show="signatureTab === 'draw'">Draw with mouse or finger on the pad above.</p>
    </div>

    <div class="mt-4" x-show="signatureTab === 'upload'">
      <button type="button" class="btn-ghost w-full justify-center py-8" @click="$refs.signatureFileInput.click()">
        Choose PNG or JPEG signature image…
      </button>
    </div>

    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="closeSignatureModal()">Cancel</button>
      <button
        type="button"
        class="btn-primary"
        :disabled="signatureBusy || (signatureTab !== 'upload' && !signatureHasInk && !signatureTyped.trim())"
        @click="confirmSignature()"
      >
        <span x-text="signatureBusy ? 'Adding…' : (signatureTab === 'upload' ? 'Choose file' : 'Add signature')"></span>
      </button>
    </div>
  </div>
</div>

<div
  x-show="showShortcuts"
  x-cloak
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="shortcuts-modal-title"
  @keydown.escape.window="showShortcuts = false"
>
  <div class="modal-panel max-w-2xl" @click.outside="showShortcuts = false">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 id="shortcuts-modal-title" class="modal-title">Keyboard shortcuts</h3>
        <p class="mt-1 text-xs text-slate-muted">Press <kbd class="rounded-sm border border-slate-line px-1 font-mono text-[10px]">?</kbd> anytime.</p>
      </div>
      <button type="button" class="btn-ghost" @click="showShortcuts = false">Close</button>
    </div>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      <template x-for="group in shortcutGroups" :key="group.title">
        <div>
          <p class="panel-label mb-2" x-text="group.title"></p>
          <ul class="space-y-1.5">
            <template x-for="item in group.items" :key="item.keys">
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-slate-muted" x-text="item.action"></span>
                <kbd class="shrink-0 rounded-md border border-slate-line bg-slate-hover px-1.5 py-0.5 font-mono text-[10px] text-fg" x-text="item.keys"></kbd>
              </li>
            </template>
          </ul>
        </div>
      </template>
    </div>
  </div>
</div>

<div
  x-show="showWatermarkModal"
  x-cloak
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="watermark-modal-title"
  @keydown.escape.window="showWatermarkModal = false"
>
  <div class="modal-panel" @click.outside="showWatermarkModal = false">
    <h3 id="watermark-modal-title" class="modal-title">Watermark</h3>
    <p class="mt-1 text-xs text-slate-muted">Shown on every page. Image uploads use the session upload API.</p>
    <div class="mt-4 flex gap-1 rounded-xl border border-slate-line bg-black/5 p-1 dark:bg-white/5">
      <button
        type="button"
        class="flex-1 rounded-lg px-3 py-1.5 text-xs font-medium"
        :class="watermarkDraft.type === 'text' ? 'bg-slate-panel text-fg shadow-xs' : 'text-slate-muted'"
        @click="watermarkDraft.type = 'text'"
      >Text</button>
      <button
        type="button"
        class="flex-1 rounded-lg px-3 py-1.5 text-xs font-medium"
        :class="watermarkDraft.type === 'image' ? 'bg-slate-panel text-fg shadow-xs' : 'text-slate-muted'"
        @click="watermarkDraft.type = 'image'"
      >Image</button>
    </div>
    <div class="mt-4 space-y-3 text-sm" x-show="watermarkDraft.type === 'text'">
      <div>
        <label class="panel-label" for="wm-text">Text</label>
        <input id="wm-text" type="text" class="panel-input" x-model="watermarkDraft.text" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="panel-label" for="wm-size">Size</label>
          <input id="wm-size" type="number" min="12" max="160" class="panel-input" x-model.number="watermarkDraft.fontSize" />
        </div>
        <div>
          <label class="panel-label" for="wm-color">Color</label>
          <input id="wm-color" type="color" class="h-9 w-full cursor-pointer rounded-lg border border-slate-line bg-transparent" x-model="watermarkDraft.color" />
        </div>
      </div>
    </div>
    <div class="mt-4 space-y-3 text-sm" x-show="watermarkDraft.type === 'image'">
      <div>
        <label class="panel-label">Image</label>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <button type="button" class="btn-ghost" @click="$refs.watermarkImageInput.click()">Upload…</button>
          <span class="truncate text-xs text-slate-muted" x-text="watermarkDraft.src ? 'Image ready' : 'No image yet'"></span>
        </div>
        <input type="file" accept="image/png,image/jpeg" class="hidden" x-ref="watermarkImageInput" @change="onWatermarkImageSelected($event)" />
      </div>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
      <div>
        <label class="panel-label">Opacity</label>
        <input type="range" min="0.04" max="0.6" step="0.01" class="w-full accent-accent" x-model.number="watermarkDraft.opacity" />
        <p class="mt-1 text-xs text-slate-muted" x-text="Math.round(watermarkDraft.opacity * 100) + '%'"></p>
      </div>
      <div>
        <label class="panel-label" for="wm-rot">Rotation°</label>
        <input id="wm-rot" type="number" min="-180" max="180" class="panel-input" x-model.number="watermarkDraft.rotation" />
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="showWatermarkModal = false">Cancel</button>
      <button type="button" class="btn-ghost" @click="clearWatermark(); showWatermarkModal = false">Remove</button>
      <button type="button" class="btn-primary" @click="applyWatermarkDraft()">Apply</button>
    </div>
  </div>
</div>

{{!-- Redaction confirm --}}
<div x-show="showRedactConfirm" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showRedactConfirm = false">
  <div class="modal-panel max-w-md" @click.outside="showRedactConfirm = false">
    <header class="modal-head">
      <h3 class="modal-title">Confirm redactions</h3>
      <p class="modal-lead">Black bars burn in on export. Review before you commit.</p>
    </header>
    <ul class="mt-4 max-h-48 space-y-1 overflow-y-auto text-xs">
      <template x-for="(r, i) in redactRects()" :key="r.id">
        <li class="file-chip" x-text="'Page ' + (r.pageIndex + 1) + ' · ' + Math.round(r.width) + '×' + Math.round(r.height) + ' pt'"></li>
      </template>
      <li x-show="!redactRects().length" class="empty-state py-4">
        <p class="empty-state-body">No redaction marks on the document.</p>
      </li>
    </ul>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="showRedactConfirm = false">Cancel</button>
      <button type="button" class="btn-primary" :disabled="!redactRects().length" @click="confirmRedactionsAndExport()">Confirm &amp; export</button>
    </div>
  </div>
</div>

{{!-- Fill & Sign wizard --}}
<div x-show="showFillSign" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showFillSign = false">
  <div class="modal-panel max-w-lg" @click.outside="showFillSign = false">
    <header class="modal-head">
      <h3 class="modal-title">Fill &amp; Sign</h3>
      <p class="modal-lead">Open → fill → sign → export. One path, local only.</p>
    </header>
    <ol class="wizard-steps" aria-label="Fill and sign steps">
      <li class="wizard-step" :class="{ 'is-active': fillSignStep === 0, 'is-done': fillSignStep > 0 }">
        <span class="wizard-step-index" aria-hidden="true">1</span>
        <div class="wizard-step-body">
          <p class="wizard-step-title">Open PDF</p>
          <p class="wizard-step-desc">Import an underlay to annotate.</p>
          <button type="button" class="btn-ghost mt-2 text-xs" @click="fillSignStep = 0; openPdfImportModal('overlay')">Import PDF…</button>
        </div>
      </li>
      <li class="wizard-step" :class="{ 'is-active': fillSignStep === 1, 'is-done': fillSignStep > 1 }">
        <span class="wizard-step-index" aria-hidden="true">2</span>
        <div class="wizard-step-body">
          <p class="wizard-step-title">Fill fields</p>
          <p class="wizard-step-desc">Form preview on canvas. Add fields from Settings if needed.</p>
          <button type="button" class="btn-ghost mt-2 text-xs" @click="fillSignStep = 1; formPreviewMode = true; showFillSign = false">Start filling</button>
        </div>
      </li>
      <li class="wizard-step" :class="{ 'is-active': fillSignStep === 2, 'is-done': fillSignStep > 2 }">
        <span class="wizard-step-index" aria-hidden="true">3</span>
        <div class="wizard-step-body">
          <p class="wizard-step-title">Sign</p>
          <p class="wizard-step-desc">Draw, type, or upload a signature.</p>
          <button type="button" class="btn-ghost mt-2 text-xs" @click="fillSignStep = 2; openSignatureModal()">Add signature…</button>
        </div>
      </li>
      <li class="wizard-step" :class="{ 'is-active': fillSignStep === 3, 'is-done': fillSignStep > 3 }">
        <span class="wizard-step-index" aria-hidden="true">4</span>
        <div class="wizard-step-body">
          <p class="wizard-step-title">Export</p>
          <p class="wizard-step-desc">Flatten forms and download.</p>
          <button type="button" class="btn-primary mt-2 text-xs" @click="fillSignStep = 3; exportSettings.flattenForms = true; exportSettings.flatten = true; openExportModal(); showFillSign = false">Export PDF…</button>
        </div>
      </li>
    </ol>
    <div class="modal-actions">
      <button type="button" class="btn-ghost ml-auto" @click="showFillSign = false">Close</button>
    </div>
  </div>
</div>

{{!-- Batch jobs --}}
<div x-show="showBatchModal" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showBatchModal = false">
  <div class="modal-panel max-w-lg" @click.outside="showBatchModal = false">
    <header class="modal-head">
      <h3 class="modal-title">Batch jobs</h3>
      <p class="modal-lead">Same watermark, Bates, and export settings → ZIP of PDFs.</p>
    </header>
    <label class="drop-zone mt-4 cursor-pointer">
      <input type="file" class="sr-only" accept="application/pdf,.pdf" multiple @change="onBatchFilesSelected($event)" />
      <span class="drop-zone-title" x-text="batchFiles.length ? batchFiles.length + ' PDF' + (batchFiles.length === 1 ? '' : 's') + ' selected' : 'Drop PDFs or browse'"></span>
      <span class="drop-zone-hint">Current document settings apply to every file</span>
    </label>
    <ul class="file-chip-list mt-3" x-show="batchFiles.length">
      <template x-for="(f, i) in batchFiles" :key="i">
        <li class="file-chip" x-text="f.name"></li>
      </template>
    </ul>
    <div class="modal-actions">
      <button type="button" class="btn-ghost" @click="showBatchModal = false">Cancel</button>
      <button type="button" class="btn-primary" :disabled="batchBusy || !batchFiles.length" @click="runBatchExport()">
        <span x-text="batchBusy ? 'Working…' : 'Export ZIP'"></span>
      </button>
    </div>
  </div>
</div>

{{!-- Compare PDFs --}}
<div x-show="showCompareModal" x-cloak class="modal-backdrop" role="dialog" aria-modal="true" @keydown.escape.window="showCompareModal = false">
  <div class="modal-panel max-w-3xl" @click.outside="showCompareModal = false">
    <header class="modal-head">
      <h3 class="modal-title">Compare PDFs</h3>
      <p class="modal-lead">Page 1 side-by-side. Overlay tints pixel differences.</p>
    </header>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="drop-zone drop-zone--compact cursor-pointer" :class="compareFileA && 'is-filled'">
        <span class="drop-zone-kicker">Document A</span>
        <span class="drop-zone-title" x-text="compareFileA?.name || 'Choose PDF…'"></span>
        <input type="file" accept="application/pdf,.pdf" class="sr-only" @change="onCompareFile($event, 'a')" />
      </label>
      <label class="drop-zone drop-zone--compact cursor-pointer" :class="compareFileB && 'is-filled'">
        <span class="drop-zone-kicker">Document B</span>
        <span class="drop-zone-title" x-text="compareFileB?.name || 'Choose PDF…'"></span>
        <input type="file" accept="application/pdf,.pdf" class="sr-only" @change="onCompareFile($event, 'b')" />
      </label>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <div class="seg-control" role="group" aria-label="Compare mode">
        <button type="button" class="seg-btn" :class="compareMode === 'split' && 'is-active'" @click="compareMode = 'split'; runComparePreview()">Split</button>
        <button type="button" class="seg-btn" :class="compareMode === 'overlay' && 'is-active'" @click="compareMode = 'overlay'; runComparePreview()">Overlay</button>
      </div>
      <button type="button" class="btn-ghost text-xs" @click="runComparePreview()" :disabled="!compareFileA || !compareFileB">Refresh</button>
    </div>
    <div class="compare-stage mt-4" :class="compareMode === 'split' ? 'compare-stage--split' : 'compare-stage--overlay'">
      <canvas x-ref="compareCanvasA" class="compare-canvas"></canvas>
      <canvas x-show="compareMode === 'split'" x-ref="compareCanvasB" class="compare-canvas"></canvas>
      <p class="empty-state absolute inset-0 m-0" x-show="!compareFileA || !compareFileB">
        <span class="empty-state-body">Load both PDFs to preview</span>
      </p>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-ghost ml-auto" @click="showCompareModal = false">Close</button>
    </div>
  </div>
</div>
