<header class="editor-chrome relative z-40 flex h-13 shrink-0 items-center gap-2 border-b border-slate-line px-2 sm:gap-3 sm:px-3 md:px-4" style="height: 3.25rem" data-tour="toolbar">
  <a href="/" class="group flex shrink-0 items-center gap-2" title="Home">
    <span class="flex h-8 w-8 items-center justify-center rounded-md bg-accent text-[11px] font-bold tracking-wide text-white transition group-hover:bg-accent-dim">PS</span>
    <span class="hidden text-sm font-semibold tracking-tight text-fg xl:inline">PDF Studio</span>
  </a>

  <div class="tool-group shrink-0" role="group" aria-label="Panels">
    <button
      type="button"
      class="tool-btn h-8 w-8"
      @click="toggleLeftPanel()"
      title="Insert &amp; pages"
      aria-label="Toggle insert and pages"
      :aria-pressed="showLeftPanel"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h14" />
      </svg>
    </button>
    <button
      type="button"
      class="tool-btn h-8 w-8"
      @click="toggleInspectorPanel()"
      title="Properties"
      aria-label="Toggle properties"
      :aria-pressed="showInspectorPanel"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h6v12H4V6zm10 0h6v5h-6V6zm0 8h6v4h-6v-4z" />
      </svg>
    </button>
  </div>

  <div class="hidden h-5 w-px shrink-0 bg-slate-line sm:block"></div>

  <input
    type="text"
    class="doc-title-input min-w-0 max-w-32 flex-1 sm:max-w-56 md:max-w-[18rem] lg:max-w-88"
    x-model="doc.name"
    @change="persist()"
    aria-label="Document name"
    placeholder="Untitled document"
  />

  <div class="tool-group shrink-0" role="group" aria-label="History">
    <button type="button" class="tool-btn h-7 w-7" :disabled="!canUndo" @click="undo()" title="Undo (⌘Z)">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 14l-4-4 4-4m-4 4h11a4 4 0 010 8h-1" />
      </svg>
    </button>
    <button type="button" class="tool-btn h-7 w-7" :disabled="!canRedo" @click="redo()" title="Redo (⌘Y)">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 14l4-4-4-4m4 4H8a4 4 0 000 8h1" />
      </svg>
    </button>
  </div>

  <div class="relative shrink-0">
    <button
      type="button"
      class="chrome-nav-btn"
      :class="showFileMenu && 'is-active'"
      @click="showFileMenu = !showFileMenu; showTemplates = false; showSettings = false; showPageSizeMenu = false"
    >
      File
      <svg class="hidden h-3 w-3 opacity-50 sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div
      x-show="showFileMenu"
      x-cloak
      x-transition.opacity.duration.150ms
      @click.outside="showFileMenu = false"
      class="menu-popover absolute left-0 top-full z-50 mt-1.5 w-60 py-1"
    >
      <p class="menu-section">Document</p>
      <button type="button" class="menu-item" @click="showFileMenu = false; newDocument()">New document</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; showDocLibrary = true">Open library…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; $refs.jsonInput.click()">Open JSON…</button>
      <button type="button" class="menu-item sm:hidden" @click="showFileMenu = false; showTemplates = true">Templates…</button>

      <p class="menu-section">PDF</p>
      <button type="button" class="menu-item" @click="showFileMenu = false; openPdfImportModal()">Import PDF…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; $refs.mergePdfInput.click()">Merge PDF…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; extractPageRange()">Extract pages…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; downloadExtractedPdf()">Download page range PDF…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; splitPdfDocument()">Split PDF…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; rotateActivePage(90)">Rotate page 90°</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; applyBatesNumbering()">Bates numbering…</button>
      <button
        type="button"
        class="menu-item"
        @click="showFileMenu = false; leftRail = 'bookmarks'; showLeftPanel = true; if (isCompact) showInspectorPanel = false"
      >
        Bookmarks…
      </button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openSignatureModal()">Sign PDF…</button>

      <p class="menu-section">Share &amp; export</p>
      <button type="button" class="menu-item" @click="showFileMenu = false; downloadStudioJson()">Share as JSON</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; downloadAsTemplatePack()">Share as template pack</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; saveAsUserTemplate()">Save as template…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openMailMergeModal()">Mail merge…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; exportPngProof()">Export PNG proof ZIP…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; exportActivePageImage('png')">Export page as PNG…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; exportActivePageImage('jpeg')">Export page as JPEG…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openPreflight()">Preflight checklist…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openFillSign()">Fill &amp; Sign…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; showBatchModal = true">Batch jobs…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openCompareModal()">Compare PDFs…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openESign()">E-sign (local)…</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; createShareLink()">Copy local review link</button>
      <button type="button" class="menu-item" @click="showFileMenu = false; openExportModal()">Export PDF…</button>

      <div class="my-1 border-t border-slate-line"></div>
      <button type="button" class="menu-item" @click="showFileMenu = false; startTour()">Product tour</button>
    </div>
  </div>

  <button
    type="button"
    class="chrome-nav-btn hidden shrink-0 sm:inline-flex"
    :class="showTemplates && 'is-active'"
    @click="showTemplates = !showTemplates; showFileMenu = false; showSettings = false; showPageSizeMenu = false"
  >
    Templates
  </button>

  <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
    <div class="tool-group" role="group" aria-label="Tools">
      <button type="button" class="tool-btn h-8 w-8" data-tour="help" @click="startTour()" title="Product tour">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M9.1 9a3 3 0 015.8 1c0 2-3 2.5-3 4.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 22a10 10 0 100-20 10 10 0 000 20z" />
        </svg>
      </button>
      <button type="button" class="tool-btn h-8 w-8" @click="showFindReplace = true" title="Find (⌘F)">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M11 18a7 7 0 100-14 7 7 0 000 14z" />
        </svg>
      </button>
      <button type="button" class="tool-btn h-8 w-8 hidden lg:flex" @click="showBrandKit = true" title="Brand kit">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.5M12 5h7a2 2 0 012 2v2" />
        </svg>
      </button>
      <button
        type="button"
        class="tool-btn h-8 w-8"
        @click="toggleTheme()"
        :title="theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'"
        :aria-label="theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'"
      >
        <svg x-show="theme === 'dark'" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.4 6.4l-1.4-1.4M7 7L5.6 5.6m12.8 0L17 7M7 17l-1.4 1.4M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg x-show="theme === 'light'" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
        </svg>
      </button>
      <button
        type="button"
        class="tool-btn h-8 w-8"
        @click="showSettings = !showSettings; showFileMenu = false; showTemplates = false; showPageSizeMenu = false"
        title="Settings"
        :aria-pressed="showSettings"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9c.2.6.7 1 1.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z" />
        </svg>
      </button>
    </div>

    <div class="hidden h-5 w-px bg-slate-line md:block"></div>

    <div class="relative hidden md:block" @keydown.escape.window="showPageSizeMenu && (showPageSizeMenu = false)">
      <button
        type="button"
        class="page-size-trigger"
        title="Page size"
        aria-label="Page size"
        aria-haspopup="listbox"
        :aria-expanded="showPageSizeMenu"
        @click="showPageSizeMenu = !showPageSizeMenu; showFileMenu = false; showSettings = false; showTemplates = false; showGuides = false"
      >
        <span class="page-size-sil" aria-hidden="true" :style="pageSizeThumbStyle()"></span>
        <span class="truncate" x-text="pageSizeLabel"></span>
        <svg class="h-3 w-3 shrink-0 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div
        x-show="showPageSizeMenu"
        x-cloak
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click.outside="showPageSizeMenu = false"
        class="page-size-menu"
        role="listbox"
        aria-label="Choose page size"
      >
        <div class="page-size-menu-head">
          <input
            type="search"
            class="panel-input text-xs"
            placeholder="Search A4, Letter, Arch…"
            x-model="pageSizeQuery"
            @keydown.stop
            aria-label="Filter page sizes"
          />
          <div class="page-size-common">
            <template x-for="id in commonPageSizes" :key="'c-' + id">
              <button
                type="button"
                class="page-size-chip"
                :class="doc.pageSize === id && 'is-active'"
                :aria-selected="doc.pageSize === id"
                @click="setPageSize(id)"
                x-text="pageSizeOptionLabel(id)"
              ></button>
            </template>
          </div>
        </div>
        <div class="page-size-menu-body">
          <template x-for="group in filteredPageSizeGroups" :key="group.id">
            <section class="page-size-group">
              <p class="menu-section" x-text="group.label"></p>
              <div
                class="page-size-grid"
                x-show="group.id === 'iso-a' || group.id === 'iso-b'"
              >
                <template x-for="opt in group.options" :key="opt.id">
                  <button
                    type="button"
                    class="page-size-cell"
                    :class="doc.pageSize === opt.id && 'is-active'"
                    role="option"
                    :aria-selected="doc.pageSize === opt.id"
                    :title="pageSizeDims(opt.id)"
                    @click="setPageSize(opt.id)"
                  >
                    <span x-text="opt.label"></span>
                  </button>
                </template>
              </div>
              <div class="page-size-list" x-show="group.id !== 'iso-a' && group.id !== 'iso-b'">
                <template x-for="opt in group.options" :key="opt.id">
                  <button
                    type="button"
                    class="page-size-row"
                    :class="doc.pageSize === opt.id && 'is-active'"
                    role="option"
                    :aria-selected="doc.pageSize === opt.id"
                    @click="setPageSize(opt.id)"
                  >
                    <span class="page-size-row-sil" aria-hidden="true" :style="pageSizeThumbStyle(opt.id)"></span>
                    <span class="min-w-0 flex-1 truncate text-left" x-text="opt.label"></span>
                    <span class="page-size-row-meta" x-text="pageSizeDims(opt.id)"></span>
                  </button>
                </template>
              </div>
            </section>
          </template>
          <p class="px-3 py-4 text-center text-xs text-slate-muted" x-show="!filteredPageSizeGroups.length">
            No sizes match
          </p>
        </div>
      </div>
    </div>

    <div class="zoom-cluster hidden items-center md:flex">
      <button type="button" class="zoom-btn" @click="zoomOut()" title="Zoom out">−</button>
      <button type="button" class="zoom-label" @click="fitWidth()" title="Fit width" x-text="Math.round(zoom * 100) + '%'"></button>
      <button type="button" class="zoom-btn" @click="zoomIn()" title="Zoom in">+</button>
    </div>

    <button
      type="button"
      class="btn-primary shrink-0"
      data-tour="export"
      :disabled="exporting"
      @click="openExportModal()"
      title="Export (⌘E)"
    >
      <svg class="h-3.5 w-3.5 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4" />
      </svg>
      <span class="hidden sm:inline" x-text="exporting ? '…' : 'Export'"></span>
    </button>
  </div>

  {{!-- Templates popover --}}
  <div
    x-show="showTemplates"
    x-cloak
    x-transition
    @click.outside="showTemplates = false"
    class="absolute left-1/2 top-14 z-40 w-[min(92vw,32rem)] -translate-x-1/2 rounded-2xl border border-slate-line bg-slate-panel p-4 shadow-page"
  >
    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-muted">Start from template</p>
    <div class="grid max-h-[40vh] gap-2 overflow-y-auto sm:grid-cols-2">
      <template x-for="tpl in templates" :key="tpl.id">
        <button
          type="button"
          class="template-card text-left"
          @click="applyTemplate(tpl.id)"
        >
          <span class="block text-sm font-medium text-fg" x-text="tpl.name"></span>
          <span class="mt-0.5 block text-xs leading-snug text-slate-muted" x-text="tpl.description"></span>
        </button>
      </template>
    </div>
    <div class="mt-4 border-t border-slate-line pt-3">
      <div class="mb-2 flex items-center justify-between gap-2">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-muted">My templates</p>
        <button type="button" class="btn-ghost text-[10px]" @click="saveAsUserTemplate()">Save current</button>
      </div>
      <ul class="max-h-36 space-y-1 overflow-y-auto">
        <template x-for="ut in userTemplates" :key="ut.id">
          <li class="flex items-center gap-1.5 rounded-md px-2 py-1.5 hover:bg-slate-hover">
            <button type="button" class="min-w-0 flex-1 truncate text-left text-sm text-fg" @click="applyUserTemplate(ut.id)" x-text="ut.name"></button>
            <button type="button" class="shrink-0 text-[10px] text-slate-muted" @click="renameUserTemplatePrompt(ut.id)">Rename</button>
            <button type="button" class="shrink-0 text-[10px] text-slate-muted" @click="removeUserTemplate(ut.id)">Delete</button>
          </li>
        </template>
        <li x-show="userTemplates.length === 0" class="py-3 text-center text-xs text-slate-muted">No saved templates yet.</li>
      </ul>
    </div>
  </div>

  {{!-- Settings drawer --}}
  <div
    x-show="showSettings"
    x-cloak
    x-transition
    @click.outside="showSettings = false"
    class="absolute right-3 top-14 z-40 w-[min(92vw,22rem)] rounded-2xl border border-slate-line bg-slate-panel p-4 shadow-page"
  >
    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-muted">Appearance</p>
    <div class="mb-3 flex gap-2">
      <button
        type="button"
        class="btn-ghost flex-1 justify-center"
        :class="theme === 'dark' && 'border-accent text-accent-soft'"
        @click="applyTheme('dark')"
      >Dark</button>
      <button
        type="button"
        class="btn-ghost flex-1 justify-center"
        :class="theme === 'light' && 'border-accent text-accent-soft'"
        @click="applyTheme('light')"
      >Light</button>
    </div>

    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-muted">Workspace</p>
    <div class="space-y-1 text-sm">
      <label class="settings-row">
        <span>Snap to grid</span>
        <input type="checkbox" class="accent-accent" x-model="snapEnabled" @change="saveSettings()" />
      </label>
      <label class="settings-row">
        <span>Grid overlay</span>
        <input type="checkbox" class="accent-accent" x-model="showGrid" @change="saveSettings()" />
      </label>
      <label class="settings-row">
        <span>Margin guides</span>
        <input type="checkbox" class="accent-accent" x-model="showGuides" @change="saveSettings()" />
      </label>
      <div class="px-1">
        <label class="panel-label">Margin size</label>
        <div class="mt-1 flex flex-wrap gap-1.5">
          <button type="button" class="btn-ghost text-xs" @click="applyMarginPreset('none')">None</button>
          <button type="button" class="btn-ghost text-xs" @click="applyMarginPreset('narrow')">Narrow</button>
          <button type="button" class="btn-ghost text-xs" @click="applyMarginPreset('normal')">Normal</button>
          <button type="button" class="btn-ghost text-xs" @click="applyMarginPreset('wide')">Wide</button>
          <button type="button" class="btn-ghost text-xs" @click="applyMarginGuidesAsNamed()">Pin as guides</button>
        </div>
      </div>
      <div class="px-1">
        <label class="panel-label">Named guides</label>
        <ul class="mt-1 max-h-28 space-y-1 overflow-y-auto" x-show="(doc.guides || []).length">
          <template x-for="g in (doc.guides || [])" :key="g.id">
            <li class="flex items-center gap-1.5 text-xs">
              <span class="w-4 shrink-0 font-mono text-[10px] text-slate-muted" x-text="g.axis"></span>
              <input
                type="text"
                class="panel-input min-w-0 flex-1 py-1 text-xs"
                :placeholder="Math.round(g.position) + 'pt'"
                :value="g.name || ''"
                @change="renameGuide(g.id, $event.target.value)"
              />
              <button type="button" class="btn-ghost shrink-0 px-1.5 text-[10px]" @click="removeGuide(g.id)" title="Remove">×</button>
            </li>
          </template>
        </ul>
        <p class="mt-1 text-[10px] text-slate-muted" x-show="!(doc.guides || []).length">Drag from rulers, or add:</p>
        <div class="mt-1.5 flex flex-wrap gap-1">
          <button type="button" class="btn-ghost text-[10px]" @click="addNamedGuide('x', pageSize.width / 2, 'Center V')">+ Center V</button>
          <button type="button" class="btn-ghost text-[10px]" @click="addNamedGuide('y', pageSize.height / 2, 'Center H')">+ Center H</button>
        </div>
      </div>
      <label class="settings-row">
        <span>Rulers</span>
        <input type="checkbox" class="accent-accent" x-model="showRulers" @change="saveSettings()" />
      </label>
      <label class="settings-row">
        <span>Review mode</span>
        <input type="checkbox" class="accent-accent" x-model="reviewMode" />
      </label>
    </div>

    <div class="my-3 border-t border-slate-line"></div>
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-slate-muted">Document</p>
    <div class="space-y-3 text-sm">
      <div>
        <label class="panel-label">Page background</label>
        <div class="flex items-center gap-2">
          <input type="color" class="h-9 w-12 cursor-pointer rounded-lg border border-slate-line bg-transparent" x-model="doc.pageBackground" @input="persistSoft()" @change="persist()" />
          <button type="button" class="btn-ghost" @click="doc.pageBackground = '#fcfaf5'; persist()">Paper</button>
          <button type="button" class="btn-ghost" @click="doc.pageBackground = '#ffffff'; persist()">White</button>
        </div>
      </div>
      <div>
        <label class="panel-label">Master &amp; watermark</label>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" class="btn-ghost" @click="toggleEditMaster()" x-text="editingMaster ? 'Exit master' : 'Edit master'"></button>
          <button type="button" class="btn-ghost" :class="editingMaster && masterZone === 'header' && 'bg-accent/15 text-accent-soft'" @click="setMasterZone('header')">Header</button>
          <button type="button" class="btn-ghost" :class="editingMaster && masterZone === 'footer' && 'bg-accent/15 text-accent-soft'" @click="setMasterZone('footer')">Footer</button>
          <button type="button" class="btn-ghost" @click="addMasterPageNumber()">Page #</button>
          <button type="button" class="btn-ghost" @click="togglePageApplyMaster()" x-text="activePage.applyMaster === false ? 'Apply master: off' : 'Apply master: on'"></button>
          <button type="button" class="btn-ghost" @click="openWatermarkModal()">Watermark…</button>
          <button type="button" class="btn-ghost" @click="clearWatermark()">Clear</button>
        </div>
      </div>
      <div>
        <label class="panel-label">Fillable fields</label>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" class="btn-ghost" @click="insertFormField('formText')">Text field</button>
          <button type="button" class="btn-ghost" @click="insertFormField('formCheck')">Checkbox</button>
          <button type="button" class="btn-ghost" @click="insertFormField('formSelect')">Dropdown</button>
        </div>
        <label class="settings-row mt-2">
          <span>Try filling on canvas</span>
          <input type="checkbox" class="accent-accent" x-model="formPreviewMode" />
        </label>
      </div>
      <div>
        <label class="panel-label">Canvas</label>
        <label class="settings-row">
          <span>Multi-page scroll</span>
          <input type="checkbox" class="accent-accent" :checked="multiPageScroll" @change="toggleMultiPageScroll()" />
        </label>
        <label class="settings-row">
          <span>Editable PDF ghost underlay</span>
          <input type="checkbox" class="accent-accent" x-model="editableGhostUnderlay" @change="refreshPdfUnderlay()" />
        </label>
      </div>
      <div>
        <label class="panel-label">Reviewer name</label>
        <input type="text" class="panel-input" x-model="authorName" @change="saveAuthorName()" />
      </div>
    </div>
  </div>
</header>
