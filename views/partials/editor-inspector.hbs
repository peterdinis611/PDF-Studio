<aside class="inspector-panel flex w-[15.5rem] shrink-0 flex-col border-l border-slate-line bg-rail md:w-64">
  <div class="border-b border-slate-line px-3 py-3">
    <div class="flex items-center justify-between gap-2">
      <span class="text-xs font-semibold tracking-wide text-fg">Properties</span>
      <span class="truncate rounded-md bg-slate-hover px-1.5 py-0.5 font-mono text-[10px] uppercase text-slate-muted" x-show="selected" x-text="selected?.type"></span>
    </div>
  </div>

  <div class="flex-1 space-y-4 overflow-y-auto p-3">
    <div
      x-show="selectedIds.length > 1"
      class="rounded-lg border border-accent/30 bg-accent/10 px-3 py-2.5 text-xs text-accent-soft"
    >
      <p class="font-medium" x-text="selectedIds.length + ' elements selected'"></p>
      <p class="mt-1 text-[11px] opacity-80">Editing the first selection below. Use Align tools in the dock for the group.</p>
    </div>

    <div x-show="selected" class="space-y-4">
      <p class="inspector-section">Layout</p>
      <div class="grid grid-cols-2 gap-2" x-show="!drag || drag.mode === 'pan'">
        <div>
          <label class="panel-label">X</label>
          <input type="number" class="panel-input" x-model.number="selected.x" @change="persist()" />
        </div>
        <div>
          <label class="panel-label">Y</label>
          <input type="number" class="panel-input" x-model.number="selected.y" @change="persist()" />
        </div>
        <div>
          <label class="panel-label">W</label>
          <input type="number" class="panel-input" x-model.number="selected.width" @change="persist()" />
        </div>
        <div>
          <label class="panel-label">H</label>
          <input type="number" class="panel-input" x-model.number="selected.height" @change="persist()" />
        </div>
      </div>
      <p x-show="drag && drag.mode !== 'pan'" class="text-[11px] text-slate-muted">Moving… release to edit numbers.</p>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="panel-label">Rotation</label>
          <input type="number" class="panel-input" min="-180" max="180" x-model.number="selected.rotation" @change="persist()" />
        </div>
        <div>
          <label class="panel-label">Locked</label>
          <button
            type="button"
            class="panel-input text-left"
            @click="toggleLock()"
            x-text="selected.locked ? 'Locked' : 'Unlocked'"
          ></button>
        </div>
      </div>

      <p class="inspector-section">Appearance</p>
      <div>
        <label class="panel-label">Opacity</label>
        <input
          type="range"
          min="0.1"
          max="1"
          step="0.05"
          class="w-full accent-accent"
          x-model.number="selected.opacity"
          @input="persistSoft()"
          @change="persist()"
        />
      </div>

      <div>
        <label class="panel-label">Layer order</label>
        <div class="flex flex-wrap gap-1">
          <button type="button" class="rounded border border-slate-line px-2 py-1 text-xs text-slate-muted hover:text-fg" @click="bringToFront()">Front</button>
          <button type="button" class="rounded border border-slate-line px-2 py-1 text-xs text-slate-muted hover:text-fg" @click="bringForward()">Up</button>
          <button type="button" class="rounded border border-slate-line px-2 py-1 text-xs text-slate-muted hover:text-fg" @click="sendBackward()">Down</button>
          <button type="button" class="rounded border border-slate-line px-2 py-1 text-xs text-slate-muted hover:text-fg" @click="sendToBack()">Back</button>
        </div>
      </div>

      <template x-if="selected?.type === 'text'">
        <div class="space-y-3">
          <p class="inspector-section">Typography</p>
          <div>
            <label class="panel-label">Content</label>
            <textarea class="panel-input min-h-[5rem] resize-y" x-model="selected.content" @change="persist()"></textarea>
          </div>
            <div>
            <label class="panel-label">Font</label>
            <select class="panel-select" x-model="selected.fontFamily" @change="persist()">
              <template x-for="f in fontOptions" :key="f.id">
                <option :value="f.id" x-text="f.label"></option>
              </template>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Size</label>
              <input type="number" class="panel-input" min="8" max="120" x-model.number="selected.fontSize" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Weight</label>
              <select class="panel-select" x-model="selected.fontWeight" @change="persist()">
                <option value="normal">Regular</option>
                <option value="bold">Bold</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Style</label>
              <select class="panel-select" x-model="selected.fontStyle" @change="persist()">
                <option value="normal">Normal</option>
                <option value="italic">Italic</option>
              </select>
            </div>
            <div>
              <label class="panel-label">List</label>
              <select class="panel-select" x-model="selected.listStyle" @change="persist()">
                <option value="none">None</option>
                <option value="bullet">Bullets</option>
                <option value="number">Numbers</option>
              </select>
            </div>
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-muted">
            <input type="checkbox" class="accent-accent" x-model="selected.underline" @change="persist()" />
            Underline
          </label>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Line height</label>
              <input type="number" class="panel-input" min="0.8" max="3" step="0.05" x-model.number="selected.lineHeight" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Letter spacing</label>
              <input type="number" class="panel-input" min="-2" max="10" step="0.1" x-model.number="selected.letterSpacing" @change="persist()" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Color</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @input="persistSoft()" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Align</label>
              <select class="panel-select" x-model="selected.align" @change="persist()">
                <option value="left">Left</option>
                <option value="center">Center</option>
                <option value="right">Right</option>
              </select>
            </div>
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'rect' || selected?.type === 'ellipse'">
        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Fill</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.fill" @input="persistSoft()" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Stroke</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.stroke" @input="persistSoft()" @change="persist()" />
            </div>
          </div>
          <div>
            <label class="panel-label">Stroke width</label>
            <input type="number" class="panel-input" min="0" max="40" x-model.number="selected.strokeWidth" @change="persist()" />
          </div>
          <div x-show="selected?.type === 'rect'">
            <label class="panel-label">Corner radius</label>
            <input type="number" class="panel-input" min="0" max="80" x-model.number="selected.cornerRadius" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'line' || selected?.type === 'arrow' || selected?.type === 'divider'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Stroke</label>
            <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.stroke" @input="persistSoft()" @change="persist()" />
          </div>
          <div>
            <label class="panel-label">Stroke width</label>
            <input type="number" class="panel-input" min="1" max="40" x-model.number="selected.strokeWidth" @change="persist()" />
          </div>
          <div x-show="selected?.type === 'arrow'">
            <label class="panel-label">Arrow head</label>
            <input type="number" class="panel-input" min="6" max="40" x-model.number="selected.headSize" @change="persist()" />
          </div>
          <div x-show="selected?.type === 'divider'">
            <label class="panel-label">Style</label>
            <select class="panel-select" x-model="selected.style" @change="persist()">
              <option value="solid">Solid</option>
              <option value="dashed">Dashed</option>
            </select>
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'sticky'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Note</label>
            <textarea class="panel-input min-h-[5rem] resize-y" x-model="selected.content" @change="persist()"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Paper</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.fill" @input="persistSoft()" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Ink</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @input="persistSoft()" @change="persist()" />
            </div>
          </div>
          <div>
            <label class="panel-label">Font size</label>
            <input type="number" class="panel-input" min="8" max="48" x-model.number="selected.fontSize" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'badge' || selected?.type === 'stamp'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Label</label>
            <input type="text" class="panel-input" x-model="selected.label" @change="persist()" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div x-show="selected?.type === 'badge'">
              <label class="panel-label">Fill</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.fill" @input="persistSoft()" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Color</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @input="persistSoft()" @change="persist()" />
            </div>
          </div>
          <div>
            <label class="panel-label">Font size</label>
            <input type="number" class="panel-input" min="8" max="48" x-model.number="selected.fontSize" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'checkbox'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Label</label>
            <input type="text" class="panel-input" x-model="selected.label" @change="persist()" />
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-muted">
            <input type="checkbox" class="accent-accent" x-model="selected.checked" @change="persist()" />
            Checked
          </label>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Color</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @input="persistSoft()" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Size</label>
              <input type="number" class="panel-input" min="8" max="32" x-model.number="selected.fontSize" @change="persist()" />
            </div>
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'icon'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Icon</label>
            <select class="panel-select" x-model="selected.icon" @change="persist()">
              <option value="star">Star</option>
              <option value="heart">Heart</option>
              <option value="check">Check</option>
              <option value="x">Close</option>
              <option value="warning">Warning</option>
              <option value="info">Info</option>
              <option value="mail">Mail</option>
              <option value="phone">Phone</option>
              <option value="pin">Pin</option>
              <option value="user">User</option>
            </select>
          </div>
          <div>
            <label class="panel-label">Color</label>
            <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @input="persistSoft()" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'table'">
        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Rows</label>
              <input type="number" class="panel-input" min="1" max="24" :value="selected.rows" @change="resizeSelectedTable(Number($event.target.value), selected.cols)" />
            </div>
            <div>
              <label class="panel-label">Cols</label>
              <input type="number" class="panel-input" min="1" max="12" :value="selected.cols" @change="resizeSelectedTable(selected.rows, Number($event.target.value))" />
            </div>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" class="btn-ghost text-xs" @click="tableInsertRow()">+ Row</button>
            <button type="button" class="btn-ghost text-xs" @click="tableInsertCol()">+ Col</button>
            <button type="button" class="btn-ghost text-xs" @click="tableDeleteRow()">− Row</button>
            <button type="button" class="btn-ghost text-xs" @click="tableDeleteCol()">− Col</button>
          </div>
          <label class="flex items-center gap-2 text-sm text-slate-muted">
            <input type="checkbox" class="accent-accent" x-model="selected.header" @change="persist()" />
            Header row
          </label>
          <div>
            <label class="panel-label">Cells (one per line)</label>
            <textarea
              class="panel-input min-h-[6rem] resize-y font-mono text-xs"
              :value="selected.cells.join('\n')"
              @change="selected.cells = $event.target.value.split(/\n/).slice(0, selected.rows * selected.cols); while (selected.cells.length < selected.rows * selected.cols) selected.cells.push(''); persist()"
            ></textarea>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Header fill</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.headerFill" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Cell fill</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.fill" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Text</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Border</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.stroke" @change="persist()" />
            </div>
          </div>
          <div>
            <label class="panel-label">Font size</label>
            <input type="number" class="panel-input" min="6" max="48" x-model.number="selected.fontSize" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'formText' || selected?.type === 'formSelect'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Field name</label>
            <input type="text" class="panel-input" x-model="selected.name" @change="persist()" />
          </div>
          <div x-show="selected?.type === 'formText'">
            <label class="panel-label">Placeholder</label>
            <input type="text" class="panel-input" x-model="selected.placeholder" @change="persist()" />
          </div>
          <div x-show="selected?.type === 'formSelect'">
            <label class="panel-label">Options (one per line)</label>
            <textarea
              class="panel-input min-h-[4rem] font-mono text-xs"
              :value="selected.options.join('\n')"
              @change="selected.options = $event.target.value.split(/\n/).filter(Boolean); persist()"
            ></textarea>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="panel-label">Color</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.color" @change="persist()" />
            </div>
            <div>
              <label class="panel-label">Border</label>
              <input type="color" class="h-9 w-full cursor-pointer rounded border border-slate-line bg-transparent" x-model="selected.borderColor" @change="persist()" />
            </div>
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'formCheck'">
        <div class="space-y-3">
          <div>
            <label class="panel-label">Field name</label>
            <input type="text" class="panel-input" x-model="selected.name" @change="persist()" />
          </div>
          <div>
            <label class="panel-label">Label</label>
            <input type="text" class="panel-input" x-model="selected.label" @change="persist()" />
          </div>
        </div>
      </template>

      <template x-if="selected?.type === 'image' || selected?.type === 'signature'">
        <div class="space-y-3">
          <div>
            <label class="panel-label" x-text="selected.type === 'signature' ? 'Signature' : 'File'"></label>
            <p class="truncate text-sm text-slate-muted" x-text="selected.name"></p>
          </div>
          <div x-show="selected.type === 'image'">
            <label class="panel-label">Fit</label>
            <div class="mt-1 flex flex-wrap gap-1.5">
              <button type="button" class="btn-ghost text-xs" :class="(selected.objectFit || 'contain') === 'contain' && 'bg-accent/15 text-accent-soft'" @click="setImageObjectFit('contain')">Contain</button>
              <button type="button" class="btn-ghost text-xs" :class="selected.objectFit === 'cover' && 'bg-accent/15 text-accent-soft'" @click="setImageObjectFit('cover')">Cover</button>
              <button type="button" class="btn-ghost text-xs" :class="selected.objectFit === 'fill' && 'bg-accent/15 text-accent-soft'" @click="setImageObjectFit('fill')">Fill</button>
            </div>
            <label class="panel-label mt-3">Crop (%)</label>
            <div class="mt-1 grid grid-cols-2 gap-2">
              <div>
                <span class="text-[10px] text-slate-muted">Top</span>
                <input type="number" min="0" max="40" class="panel-input" :value="(selected.crop && selected.crop.top) || 0" @change="setImageCrop('top', Number($event.target.value))" />
              </div>
              <div>
                <span class="text-[10px] text-slate-muted">Bottom</span>
                <input type="number" min="0" max="40" class="panel-input" :value="(selected.crop && selected.crop.bottom) || 0" @change="setImageCrop('bottom', Number($event.target.value))" />
              </div>
              <div>
                <span class="text-[10px] text-slate-muted">Left</span>
                <input type="number" min="0" max="40" class="panel-input" :value="(selected.crop && selected.crop.left) || 0" @change="setImageCrop('left', Number($event.target.value))" />
              </div>
              <div>
                <span class="text-[10px] text-slate-muted">Right</span>
                <input type="number" min="0" max="40" class="panel-input" :value="(selected.crop && selected.crop.right) || 0" @change="setImageCrop('right', Number($event.target.value))" />
              </div>
            </div>
            <button type="button" class="btn-ghost mt-1.5 w-full justify-center text-xs" @click="resetImageCrop()">Reset crop</button>
          </div>
          <button
            type="button"
            class="btn-ghost w-full justify-center"
            x-show="selected.type === 'image'"
            @click="startReplaceImage()"
          >
            Replace image
          </button>
          <button
            type="button"
            class="btn-ghost w-full justify-center"
            x-show="selected.type === 'signature'"
            @click="openSignatureModal(null, null, selected.id)"
          >
            Replace signature
          </button>
        </div>
      </template>
    </div>

    <div x-show="!selected" class="empty-properties">
      <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl border border-slate-line text-slate-muted">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 11l6.768-6.768a2 2 0 012.828 0l.172.172a2 2 0 010 2.828L12 14l-4 1 1-4z" />
        </svg>
      </div>
      <p class="text-sm font-medium text-fg/80">Nothing selected</p>
      <p class="mt-1.5 text-xs leading-relaxed text-slate-muted">
        Click an element on the page, or place one from Insert.
      </p>
      <ul class="mt-3 space-y-1.5 text-left text-[11px] text-slate-muted">
        <li><kbd class="rounded border border-slate-line px-1 font-mono text-[10px]">T</kbd> text tool</li>
        <li><kbd class="rounded border border-slate-line px-1 font-mono text-[10px]">/</kbd> search library</li>
        <li><kbd class="rounded border border-slate-line px-1 font-mono text-[10px]">Shift</kbd> + click multi-select</li>
      </ul>
      <button
        type="button"
        class="mt-4 text-xs font-medium text-accent-soft hover:underline"
        @click="leftRail = 'insert'; $nextTick(() => $refs.librarySearch?.focus())"
      >
        Open Insert →
      </button>
    </div>

    <div class="border-t border-slate-line pt-4">
      <label class="panel-label">Layers</label>
      <ul class="max-h-48 space-y-1 overflow-y-auto">
        <template x-for="layer in layers" :key="layer.id">
          <li
            draggable="true"
            @dragstart="onLayerDragStart(layer.id)"
            @dragover.prevent
            @drop.prevent="onLayerDrop(layer.id)"
          >
            <div
              class="flex w-full items-center gap-1 rounded-md px-1 py-1 text-left text-xs transition hover:bg-slate-hover"
              :class="isSelected(layer.id) ? 'bg-accent/15 text-accent-soft' : 'text-slate-muted'"
            >
              <button type="button" class="min-w-0 flex-1 truncate px-1 py-0.5 text-left font-medium" @click="selectedIds = [layer.id]" x-text="layer.label"></button>
              <span x-show="layer.groupId" class="text-[9px] text-accent-soft">G</span>
              <span class="font-mono text-[10px] uppercase opacity-60" x-text="layer.type"></span>
              <button
                type="button"
                class="rounded px-1 opacity-70 hover:opacity-100"
                :title="layer.visible ? 'Hide' : 'Show'"
                @click.stop="toggleVisibility(layer.id)"
                x-text="layer.visible ? '👁' : '⊘'"
              ></button>
              <button type="button" class="rounded px-1 opacity-70 hover:opacity-100" @click.stop="selectedIds = [layer.id]; toggleLock()" x-text="layer.locked ? '🔒' : '🔓'"></button>
            </div>
          </li>
        </template>
        <li x-show="layers.length === 0" class="px-2 py-2 text-xs text-slate-muted">No elements on this page.</li>
      </ul>
      <div class="mt-2 flex flex-wrap gap-1" x-show="selected">
        <button type="button" class="btn-ghost text-[10px]" @click="bringToFront()">Front</button>
        <button type="button" class="btn-ghost text-[10px]" @click="bringForward()">↑</button>
        <button type="button" class="btn-ghost text-[10px]" @click="sendBackward()">↓</button>
        <button type="button" class="btn-ghost text-[10px]" @click="sendToBack()">Back</button>
      </div>
    </div>

    <div class="border-t border-slate-line pt-4" x-show="pageComments.length">
      <label class="panel-label">Comments</label>
      <ul class="max-h-32 space-y-2 overflow-y-auto text-xs">
        <template x-for="c in pageComments" :key="c.id">
          <li class="rounded border border-slate-line p-2" :class="c.resolved && 'opacity-50'">
            <p class="font-medium text-fg" x-text="c.author"></p>
            <p class="text-slate-muted" x-text="c.body"></p>
          </li>
        </template>
      </ul>
    </div>
  </div>
</aside>
