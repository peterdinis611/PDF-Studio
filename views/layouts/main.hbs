<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    {{> favicon}}
    <script>
      (function () {
        var t = localStorage.getItem("pdf-studio-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,560;0,9..144,700;1,9..144,500;1,9..144,560&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{assets.css}}" />
  </head>
  <body class="h-full">
    {{> preload preloadMin=650}}
    {{{body}}}
    <script type="module" src="{{assets.js}}"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
  </body>
</html>
