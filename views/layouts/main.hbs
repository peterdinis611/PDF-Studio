<!DOCTYPE html>

<html lang="en" class="h-full" data-theme="dark" {{#if newsprint}}data-newsprint{{/if}}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="color-scheme" content="dark light" />

    <!-- Primary SEO -->
    <title>{{title}}</title>

    {{#if description}}
    <meta name="description" content="{{description}}" />
    {{/if}}

    <meta name="author" content="PDF Studio" />
    <meta name="application-name" content="{{#if applicationName}}{{applicationName}}{{else}}PDF Studio{{/if}}" />
    <meta name="apple-mobile-web-app-title" content="PDF Studio" />
    <meta name="format-detection" content="telephone=no" />

    {{#if keywords}}
    <meta name="keywords" content="{{keywords}}" />
    {{/if}}

    {{#if noindex}}
    <meta name="robots" content="noindex, follow" />
    {{else}}
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    {{/if}}

    <meta name="googlebot" content="index, follow, max-image-preview:large" />
    <meta name="bingbot" content="index, follow" />

    {{#if canonical}}
    <link rel="canonical" href="{{canonical}}" />
    {{/if}}

    <!-- Language / localization -->
    <meta http-equiv="content-language" content="en" />
    <link rel="alternate" hreflang="en" href="{{#if canonical}}{{canonical}}{{else}}/{{/if}}" />
    <link rel="alternate" hreflang="x-default" href="{{#if siteUrl}}{{siteUrl}}/{{else}}/{{/if}}" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="PDF Studio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{title}}" />

    {{#if description}}
    <meta property="og:description" content="{{description}}" />
    {{/if}}

    {{#if ogUrl}}
    <meta property="og:url" content="{{ogUrl}}" />
    {{/if}}

    <meta property="og:locale" content="en_US" />

    {{#if ogImage}}
    <meta property="og:image" content="{{ogImage}}" />
    <meta property="og:image:secure_url" content="{{ogImage}}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="{{#if ogImageAlt}}{{ogImageAlt}}{{else}}PDF Studio — local-first PDF editor{{/if}}"
    />
    {{/if}}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}}" />

    {{#if description}}
    <meta name="twitter:description" content="{{description}}" />
    {{/if}}

    {{#if ogImage}}
    <meta name="twitter:image" content="{{ogImage}}" />
    <meta
      name="twitter:image:alt"
      content="{{#if ogImageAlt}}{{ogImageAlt}}{{else}}PDF Studio — local-first PDF editor{{/if}}"
    />
    {{/if}}

    <!-- Optional: Twitter/X account -->
    {{#if twitterSite}}
    <meta name="twitter:site" content="{{twitterSite}}" />
    {{/if}}

    {{#if twitterCreator}}
    <meta name="twitter:creator" content="{{twitterCreator}}" />
    {{/if}}

    <!-- Favicons -->
    {{> favicon}}

    <!-- Theme -->
    <script>
      (function () {
        var t = localStorage.getItem("pdf-studio-theme");

        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }

        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    {{#if newsprint}}

    <!-- Self-hosted fonts -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/bodoni-moda-latin-standard-normal.woff2"
      crossorigin
    />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/newsreader-latin-wght-normal.woff2"
      crossorigin
    />

    {{else}}

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    {{/if}}

    <!-- CSS -->
    <link rel="stylesheet" href="{{assets.css}}" />

    <!-- Structured data -->
    {{#if jsonLd}}
    <script type="application/ld+json">{{{jsonLd}}}</script>
    {{else}}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "PDF Studio",
        "url": "{{siteUrl}}",
        "description": "{{description}}"
      }
    </script>
    {{/if}}
  </head>

  <body class="h-full">
    {{> preload preloadMin=650}}

    {{{body}}}

    <script type="module" src="{{assets.js}}"></script>

    <script defer src="{{assets.alpine}}"></script>
  </body>
</html>