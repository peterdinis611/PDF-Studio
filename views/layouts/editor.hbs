<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    {{> favicon}}
    <script>
      (function () {
        var t = localStorage.getItem("pdf-studio-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <!-- Self-hosted newsprint chrome fonts (same stack as the landing page) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/bodoni-moda-latin-standard-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/newsreader-latin-wght-normal.woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {{!-- Document catalog + Caveat for signatures. Chrome UI uses self-hosted Newsreader/Bodoni/Courier. --}}
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:ital,wght@0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:ital,wght@0,400;0,700;1,400&family=Nunito:ital,wght@0,400;0,700;1,400&family=Open+Sans:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Raleway:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{assets.css}}" />
  </head>
  <body class="h-full overflow-hidden">
    {{> preload preloadMin=900}}
    {{{body}}}
    <script type="module" src="{{assets.js}}"></script>
    <script defer src="{{assets.alpine}}"></script>
  </body>
</html>
