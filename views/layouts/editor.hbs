<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{{title}}</title>

    {{#if description}}
    <meta name="description" content="{{description}}" />
    {{/if}}

    <meta name="author" content="PDF Studio" />
    <meta name="application-name" content="PDF Studio" />
    <meta name="apple-mobile-web-app-title" content="PDF Studio" />
    <meta name="theme-color" content="#b0281b" />

    {{#if keywords}}
    <meta name="keywords" content="{{keywords}}" />
    {{/if}}

    {{#if noindex}}
    <meta name="robots" content="noindex, follow" />
    {{else}}
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    {{/if}}

    {{#if canonical}}
    <link rel="canonical" href="{{canonical}}" />
    {{/if}}

    <meta property="og:site_name" content="PDF Studio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{title}}" />
    {{#if description}}
    <meta property="og:description" content="{{description}}" />
    {{/if}}
    {{#if ogUrl}}
    <meta property="og:url" content="{{ogUrl}}" />
    {{/if}}
    <meta property="og:locale" content="en_US" />
    {{#if ogImage}}
    <meta property="og:image" content="{{ogImage}}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="{{#if ogImageAlt}}{{ogImageAlt}}{{else}}PDF Studio editor{{/if}}"
    />
    {{/if}}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}}" />
    {{#if description}}
    <meta name="twitter:description" content="{{description}}" />
    {{/if}}
    {{#if ogImage}}
    <meta name="twitter:image" content="{{ogImage}}" />
    {{/if}}

    {{> favicon}}
    <script>
      (function () {
        var t = localStorage.getItem("pdf-studio-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <!-- Self-hosted newsprint chrome fonts (same stack as the landing page) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/bodoni-moda-latin-standard-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/public/fonts/newsreader-latin-wght-normal.woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {{!-- Document catalog + Caveat for signatures. Chrome UI uses self-hosted Newsreader/Bodoni/Courier. --}}
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:ital,wght@0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:ital,wght@0,400;0,700;1,400&family=Nunito:ital,wght@0,400;0,700;1,400&family=Open+Sans:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Raleway:ital,wght@0,400;0,700;1,400&family=Roboto:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{assets.css}}" />

    {{#if jsonLd}}
    <script type="application/ld+json">{{{jsonLd}}}</script>
    {{/if}}
  </head>
  <body class="h-full overflow-hidden">
    {{> preload preloadMin=900}}
    {{{body}}}
    <script type="module" src="{{assets.js}}"></script>
    <script defer src="{{assets.alpine}}"></script>
  </body>
</html>
