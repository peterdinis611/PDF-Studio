<a class="editor-skip" href="#editor-main">Skip to editor</a>
<div
  x-data="pdfEditor"
  @keydown.window="onKeydown($event)"
  class="editor-shell flex h-full flex-col"
  :class="{
    'is-compact': isCompact,
    'rail-open': showLeftPanel,
    'inspector-open': showInspectorPanel,
  }"
>
  {{> editor-toolbar}}

  <main id="editor-main" class="editor-workspace relative flex min-h-0 flex-1 overflow-hidden">
    <div
      class="editor-scrim"
      x-show="isCompact && (showLeftPanel || showInspectorPanel)"
      x-cloak
      x-transition.opacity.duration.150ms
      @click="closeOverlayPanels()"
      aria-hidden="true"
    ></div>

    {{> editor-rail}}

    {{> editor-canvas}}

    {{> editor-inspector}}
  </main>

  <footer class="status-bar">
    <div class="flex min-w-0 items-center gap-1.5 overflow-hidden sm:gap-2">
      <div class="status-page-nav shrink-0" role="navigation" aria-label="Page">
        <button
          type="button"
          class="status-page-btn"
          @click="prevPage()"
          :disabled="activePageIndex <= 0"
          title="Previous page (Page Up)"
          aria-label="Previous page"
        >‹</button>
        <button
          type="button"
          class="status-chip status-page-label"
          @click="leftRail = 'pages'; showLeftPanel = true; if (isCompact) showInspectorPanel = false"
          :title="'Open pages · ' + pageLabel"
          x-text="'Page ' + pageLabel"
        ></button>
        <button
          type="button"
          class="status-page-btn"
          @click="nextPage()"
          :disabled="activePageIndex >= doc.pages.length - 1"
          title="Next page (Page Down)"
          aria-label="Next page"
        >›</button>
        <button
          type="button"
          class="status-page-btn"
          @click="addPage()"
          title="Add page"
          aria-label="Add page"
        >+</button>
      </div>
      <span
        class="status-chip accent hidden truncate sm:inline-flex"
        x-show="doc.importedPdf && hasSessionPdf()"
        x-text="doc.importedPdf.name || 'PDF'"
      ></span>
      <span
        class="status-chip hidden sm:inline-flex"
        x-show="pdfRasterLabel"
        x-text="pdfRasterLabel"
        :title="pdfRasterLabel === 'EmbedPDF' ? 'Rendered with EmbedPDF (PDFium)' : 'Fallback renderer'"
      ></span>
      <button
        type="button"
        class="status-chip accent shrink-0"
        x-show="pdfNeedsReattach()"
        @click="requestPdfReattach()"
      >Re-attach</button>
      <span class="status-chip shrink-0" x-show="selectedIds.length" x-text="selectedIds.length + ' sel'"></span>
      <span class="status-chip accent hidden sm:inline-flex" x-show="editingMaster" x-text="'Master · ' + masterZone"></span>
      <span class="status-chip accent hidden sm:inline-flex" x-show="reviewMode">Review</span>
      <span class="status-chip" x-show="saveState === 'saving'">Saving…</span>
      <span class="status-chip" x-show="saveState === 'saved'">Saved</span>
    </div>
    <p class="status-hints flex lg:hidden" x-show="isCompact">
      <button type="button" @click="showShortcuts = true"><kbd>?</kbd></button>
      <button type="button" class="status-action" @click="startTour()">Tour</button>
    </p>
    <p class="status-hints hidden lg:flex">
      <span><kbd>Space</kbd> pan</span>
      <span><kbd>⌘</kbd> zoom</span>
      <span><kbd>/</kbd> search</span>
      <button type="button" @click="showShortcuts = true"><kbd>?</kbd></button>
    </p>
    <div class="zoom-cluster flex shrink-0 items-center" role="group" aria-label="Zoom">
      <button type="button" class="zoom-btn" @click="zoomOut()" title="Zoom out (−)" aria-label="Zoom out">−</button>
      <button type="button" class="zoom-label" @click="fitPage()" title="Fit page (⌘0)" x-text="Math.round(zoom * 100) + '%'"></button>
      <button type="button" class="zoom-btn" @click="zoomIn()" title="Zoom in (+)" aria-label="Zoom in">+</button>
      <button type="button" class="status-action hidden border-l border-slate-line px-1.5 sm:inline" @click="fitWidth()" title="Fit width">Width</button>
    </div>
  </footer>

  <div
    x-show="toast"
    x-cloak
    x-transition.opacity.duration.200ms
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed bottom-20 left-1/2 z-80 max-w-[min(90vw,28rem)] -translate-x-1/2 rounded-full border border-slate-line bg-rail/95 px-4 py-2 text-center text-xs font-medium text-fg shadow-lg backdrop-blur-sm sm:bottom-24"
    x-text="toast"
  ></div>

  <input type="file" accept="image/png,image/jpeg" class="hidden" x-ref="imageInput" @change="onImageSelected($event)" />
  <input type="file" accept="image/png,image/jpeg" class="hidden" x-ref="signatureFileInput" @change="onSignatureFileSelected($event)" />
  <input type="file" accept="application/pdf,.pdf" class="hidden" x-ref="pdfInput" @change="onPdfImportSelected($event)" />
  <input type="file" accept="application/pdf,.pdf" class="hidden" x-ref="mergePdfInput" @change="mergePdfSelected($event)" />
  <input type="file" accept="application/json,.json,.pdfstudio.json" class="hidden" x-ref="jsonInput" @change="onStudioJsonSelected($event)" />
  <input type="file" accept="image/png,image/jpeg" class="hidden" x-ref="brandLogoInput" @change="onBrandLogoSelected($event)" />

  {{> editor-modals}}
</div>
