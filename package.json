{
  "name": "pdf-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:fonts && concurrently -k -n server,css,client -c blue,magenta,green \"tsx watch src/server/index.ts\" \"npm run build:css -- --watch\" \"node scripts/build-client.mjs --watch\"",
    "build": "npm run build:fonts && npm run build:css && npm run build:client && npm run build:assets && tsc -p tsconfig.server.json",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "build:client": "node scripts/build-client.mjs",
    "build:assets": "node scripts/hash-assets.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "batch": "tsx src/cli/batchMerge.ts"
  },
  "bin": {
    "pdf-studio-batch": "./dist/cli/batchMerge.js"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/markdown": "^1.2.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-table-cell": "^3.33.0",
    "@tiptap/extension-table-header": "^3.33.0",
    "@tiptap/extension-table-row": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "alpinejs": "^3.17.5",
    "animejs": "^4.5.0",
    "date-fns": "^4.4.0",
    "driver.js": "^1.10.2",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.4",
    "fuse.js": "^7.5.0",
    "image-size": "^2.1.0",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/alpinejs": "^3.13.11",
    "@types/express": "^5.0.6",
    "@types/image-size": "^0.7.0",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pino-http": "^5.8.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
